# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Local dev runtime config (MCP servers, checkpoints, artifacts, knowledge base)
# Anchored and explicit — a bare "config/" also matches api/src/config/
# (application source, must stay tracked), which it silently did before.
/config/
/api/config/
/data/

# Playwright E2E artifacts
e2e/playwright-report/
e2e/test-results/

# Evaluation run artifacts (YAML results, HTML reports, review manifests)
eval-results/
eval-logs/

# Thread report CLI output (bin/thread-report.ts) — anchored so it doesn't
# also match lib/thread-reports/ (see the api/src/config/ fix earlier).
/thread-reports/

# Local npm registry auth (copy .npmrc.template -> .npmrc)
.npmrc

# SQLite database created by running the API locally (dev:api / e2e webServer)
/api/app.db
/api/app.db-shm
/api/app.db-wal

# Mac OS
.DS_Store

# Local Scripts
temp.sh