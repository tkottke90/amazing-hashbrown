{% set details = result.details %}
{% set isPending = details.type === 'human' and details.status === 'pending' %}
{% set isSkipped = details.type === 'skipped' or (details.type === 'human' and details.status === 'skipped') %}
{% set scenario = scenariosById[result.scenarioId] %}
{% set detailId = 'detail-' + result.id %}

<tr class="scenario-row" data-target="{{ detailId }}" tabindex="0" role="button" aria-expanded="false" aria-controls="{{ detailId }}">
  <td>
    {% if result.passed %}
      <span class="badge badge-pass">✓ pass</span>
    {% elif isPending %}
      <span class="badge badge-pending">◌ pending</span>
    {% elif isSkipped %}
      <span class="badge badge-skipped">⊘ skipped</span>
    {% else %}
      <span class="badge badge-fail">✗ fail</span>
    {% endif %}
  </td>
  <td>{{ scenario.name if scenario else result.scenarioId }}</td>
  <td><span class="badge badge-type">{{ details.type }}</span></td>
  <td>{{ result.latencyMs | duration }}</td>
  <td>
    {% if result.score !== null %}
      {{ (result.score * 100) | round(1) }}%
    {% else %}
      —
    {% endif %}
  </td>
  <td class="chevron-cell"><span class="chevron">▸</span></td>
</tr>
<tr class="detail-row" id="{{ detailId }}" hidden>
  <td colspan="6">
    <div class="detail-panel">
      {% if scenario %}
        <div><strong>Purpose:</strong></div>
        <pre>{{ scenario.purpose }}</pre>
        <div style="margin-top:0.5rem"><strong>Input:</strong></div>
        <pre>{{ scenario.input }}</pre>
      {% endif %}

      <div style="margin-top:0.5rem"><strong>Output:</strong></div>
      <pre>{{ result.actualOutput }}</pre>

      {% if details.type === 'deterministic' %}
        <div style="margin-top:0.5rem"><strong>Expected ({{ details.match }}):</strong></div>
        <pre>{{ details.expected }}</pre>
      {% elif details.type === 'semantic' %}
        <div style="margin-top:0.5rem">Similarity: {{ (details.similarity * 100) | round(2) }}% (threshold: {{ (details.threshold * 100) | round(0) }}%)</div>
      {% elif details.type === 'llm-judge' %}
        <div style="margin-top:0.5rem">
          Score: {{ details.score }}/10
          {% if details.biasRisk %}<span class="badge badge-bias">⚠ bias risk</span>{% endif %}
        </div>
        <div style="margin-top:0.5rem"><strong>Judge feedback:</strong></div>
        <pre>{{ details.reasoning }}</pre>
      {% elif details.type === 'structured' %}
        <div style="margin-top:0.5rem"><strong>Field checks ({{ (details.score * 100) | round(0) }}% passed):</strong></div>
        <table class="field-check-table">
          <thead>
            <tr>
              <th>Path</th>
              <th>Match</th>
              <th>Expected</th>
              <th>Actual</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            {% for field in details.fieldResults %}
            <tr>
              <td><code>{{ field.path }}</code></td>
              <td>{{ field.match }}</td>
              <td><code>{{ field.expected }}</code></td>
              <td><code>{{ field.actual }}</code></td>
              <td>
                {% if field.passed %}
                  <span class="badge badge-pass">✓</span>
                {% else %}
                  <span class="badge badge-fail">✗</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      {% elif details.type === 'tool-call' or details.type === 'tool-sequence' %}
        <div style="margin-top:0.5rem">
          Expected tool: <code>{{ details.expectedTool }}</code> —
          Called: {% if details.toolCalled %}<code>{{ details.toolCalled }}</code>{% elif details.calledTools and details.calledTools.length %}<span class="badge badge-fail">wrong tool: {{ details.calledTools | join(', ') }}</span>{% else %}<span class="badge badge-fail">none</span>{% endif %}
        </div>
        {% if not details.toolCalled %}
          {% if details.invalidToolCalls and details.invalidToolCalls.length %}
            <div style="margin-top:0.5rem">
              <span class="badge badge-fail">⚠ malformed tool call</span>
              The model attempted a tool call that failed to parse or validate:
            </div>
            {% for invalid in details.invalidToolCalls %}
              <pre>name: {{ invalid.name }}
args: {{ invalid.args }}
error: {{ invalid.error }}</pre>
            {% endfor %}
          {% endif %}
          {% if details.reasoningContent %}
            <div style="margin-top:0.5rem">
              <strong>{% if details.calledTools and details.calledTools.length %}Wrong tool called{% else %}No tool attempted{% endif %} — model's reasoning/thinking output:</strong>
            </div>
            <pre>{{ details.reasoningContent }}</pre>
          {% endif %}
          {% if details.responseMetadata %}
            <div style="margin-top:0.5rem">
              <strong>Response metadata:</strong>
              {% if details.responseMetadata.finish_reason === 'tool_calls' and (not details.calledTools or not details.calledTools.length) %}
                <span class="badge badge-fail" title="The provider reports a tool call ended this response, but none was extracted — likely a serving-side bug, not a harness parsing gap.">⚠ finish_reason: tool_calls but none extracted</span>
              {% endif %}
            </div>
            <pre>{% for key, value in details.responseMetadata %}{{ key }}: {{ value }}
{% endfor %}</pre>
          {% endif %}
        {% endif %}
        {% if details.fieldResults.length %}
        <div style="margin-top:0.5rem"><strong>Arg checks ({{ (details.score * 100) | round(0) }}% passed):</strong></div>
        <table class="field-check-table">
          <thead>
            <tr>
              <th>Path</th>
              <th>Match</th>
              <th>Expected</th>
              <th>Actual</th>
              <th>Result</th>
            </tr>
          </thead>
          <tbody>
            {% for field in details.fieldResults %}
            <tr>
              <td><code>{{ field.path }}</code></td>
              <td>{{ field.match }}</td>
              <td><code>{{ field.expected }}</code></td>
              <td><code>{{ field.actual }}</code></td>
              <td>
                {% if field.passed %}
                  <span class="badge badge-pass">✓</span>
                {% else %}
                  <span class="badge badge-fail">✗</span>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% endif %}
      {% elif details.type === 'human' %}
        <div style="margin-top:0.5rem">Status: {{ details.status }}</div>
        {% if details.response %}
          <div style="margin-top:0.5rem"><strong>Human feedback:</strong></div>
          <pre>{{ details.response }}</pre>
        {% endif %}
        {% if details.reviewerNotes %}
          <div style="margin-top:0.5rem"><strong>Reviewer notes:</strong></div>
          <pre>{{ details.reviewerNotes }}</pre>
        {% endif %}
      {% endif %}
    </div>
  </td>
</tr>
