# Example configuration for amazing-hashbrown.
# Copy this to config.yaml (or start from a copy created by the bootstrap script)
# and edit to match your environment.

# (truncated for brevity; include your existing config lines here)

tools:
  # Example tools with default configurations.
  # shell_exec is a special tool with its own workingDirectory default.
  # It also supports an optional "env" field for extra environment variables.
  shell_exec:
    # Optional: extra env vars passed to shell_exec child commands, on top
    # of the sanitized minimal environment (PATH/HOME/USER).
    # Values must be config-manager env lookups: "${VAR}" — uppercase names
    # only; a missing variable resolves to an empty string.
    env:
      GH_TOKEN: "${GH_TOKEN}"
