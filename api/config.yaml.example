# amazing-hashbrown API configuration
#
# Copy this file to config/config.yaml and edit for your environment.
# Use ${ENV_VAR} syntax to reference environment variables from the file.
# The config/config.yaml file is auto-created from these defaults on first run
# if it does not exist. config/ is gitignored — this example is the committed
# reference.

# Port the API server listens on.
port: 3000
# port: ${PORT}

# Log level: debug | info | warn | error
logLevel: info
# logLevel: ${LOG_LEVEL}

# Absolute or relative path to the knowledge-base root directory.
wikiRoot: ./config/kb
# wikiRoot: ${WIKI_ROOT}

# Directory that holds mcp.json and other runtime config files.
# When MCP_CONFIG_PATH is set, use: dirname(MCP_CONFIG_PATH)
mcpConfigDir: ./config

# Directory where uploaded and agent-generated artifacts (images, files) are
# stored. Each artifact gets its own subdirectory containing the original
# file, processed web/preview variants, and a meta.json.
artifactRoot: ./config/artifacts

# Directory that holds AgentSkills-format skill directories (each containing
# a SKILL.md with frontmatter + instruction body). Created automatically on
# first boot if it does not exist. Relative to the config directory.
skillsRoot: ./skills

# ---------------------------------------------------------------------------
# LLM Providers
#
# At least one provider is required for the chat agent to function.
# Use ${ENV_VAR} syntax for secrets so they are not stored in the file.
# ---------------------------------------------------------------------------
providers:
  - name: local
    type: ollama
    baseUrl: http://localhost:11434
    defaultModel: llama3
  # - name: openai
  #   type: openai
  #   apiKey: ${OPENAI_API_KEY}
  #   defaultModel: gpt-4.1-mini
  # - name: anthropic
  #   type: anthropic
  #   apiKey: ${ANTHROPIC_API_KEY}
  #   defaultModel: claude-sonnet-4-6

defaultProvider: local

# ---------------------------------------------------------------------------
# Embeddings
#
# Powers semantic/hybrid wiki search (wiki_search tool's `mode`) and the
# semantic search tool inside rlm_query. When disabled, wiki search falls
# back to keyword-only matching and rlm_query uses keyword tools only —
# no error, just lower-quality retrieval.
#
# type: ollama (default) or openai
# ---------------------------------------------------------------------------
embeddings:
  enabled: true
  type: ollama
  model: nomic-embed-text
  baseUrl: http://localhost:11434/v1
  # For OpenAI embeddings:
  # type: openai
  # model: text-embedding-3-small
  # apiKey: ${OPENAI_API_KEY}

# ---------------------------------------------------------------------------
# Database
#
# Shared SQLite database used by all application features (observability,
# task system, persistent memory). Do not delete this file between restarts.
# ---------------------------------------------------------------------------
database:
  # Path to the application database file. Relative paths are resolved from the
  # directory that contains this config file. Use an absolute path for production.
  # All application features share this file.
  path: app.db

# ---------------------------------------------------------------------------
# Observability
#
# Controls agent tracing: token counts, latency, and tool call records.
# Writes to the shared database configured above.
# ---------------------------------------------------------------------------
observability:
  enabled: true
  # How many characters of LLM responses and tool results to store per span.
  # Set to -1 to store full content (high fidelity, higher disk use).
  # Set to  0 to store no content (metrics-only mode: tokens, latency, cost).
  spanOutputPreviewChars: 500

# ---------------------------------------------------------------------------
# AfterAgent Middleware
#
# Background post-response layer that inspects each conversational turn for
# novel knowledge and writes it into the wiki. Runs after the turn's SSE
# stream completes; never blocks or slows the user-facing response. Can also
# be disabled per-request via the `afterAgent` field on POST /api/v1/chat/:threadId.
# ---------------------------------------------------------------------------
afterAgent:
  enabled: true

# ---------------------------------------------------------------------------
# Chat
#
# showErrorMessages: when false (default), a failed turn that has since been
# retried is hidden from the conversation history — only the successful
# retry shows. A failed turn nobody has retried yet is always shown
# regardless of this setting. Override per-request via
# GET /api/v1/threads/:id?showErrors=true.
#
# contextWindow: sliding context window that prevents unbounded token growth.
#   enabled:   set to false to disable trimming entirely (not recommended for
#              local models with hard context limits). Default: true.
#   maxTokens: approximate token ceiling passed to the LLM per turn. Tokens
#              are estimated at 4 characters each — accurate enough for budget
#              keeping without the overhead of a model-based counter. Older
#              messages are dropped (oldest first) while preserving the system
#              prompt and ensuring the kept sequence always starts on a human
#              turn (never mid-tool-call). Default: 32000.
#
#              Safe values by model family (leave headroom for output):
#                GLM-4-Flash / small Ollama models: 16000–24000
#                Llama 3 8B/13B:                    24000–32000
#                GPT-4.1-mini / Claude Haiku:       64000–96000
#
# conversationSearch: RAG-over-history tool (search_conversation) that lets
#   the agent recall information that has scrolled out of the active window.
#   enabled:   set to false to never register the tool. Default: true.
#   threshold: minimum number of thread messages before the tool is useful
#              (below this the full history fits in context). Default: 20.
# ---------------------------------------------------------------------------
chat:
  showErrorMessages: false
  contextWindow:
    enabled: true
    maxTokens: 32000
  conversationSearch:
    enabled: true
    threshold: 20

# ---------------------------------------------------------------------------
# Web Fetch
#
# Controls the web_fetch tool available to the chat agent, wiki ingestion
# agent, and future automated task agents. The tool fetches HTML and JSON
# content only — no browser automation.
# ---------------------------------------------------------------------------
webFetch:
  # Milliseconds before a fetch request is aborted. Default: 10000 (10 s).
  timeoutMs: 10000
  # When true (default), web_fetch checks robots.txt before fetching and
  # returns a blocked message if the path is disallowed. Set to false to
  # skip the robots.txt preflight entirely (useful for internal services or
  # hosts you control).
  respectRobotsTxt: true

# ---------------------------------------------------------------------------
# RLM (Retrieval Loop Model)
#
# Controls the rlm_query tool available to the chat agent. RLM iteratively
# searches a large text corpus to answer a targeted question, avoiding the
# context rot that comes from dumping an entire document into the chat.
#
# provider: name of a provider in providers[] to use for RLM model calls.
#           Defaults to defaultProvider when omitted.
# model:    model name override for RLM. Defaults to the provider's
#           defaultModel when omitted.
# maxIterations: maximum search iterations before forcing a final answer.
# truncateThreshold: character count above which wiki_read_page truncates
#                    its response and instructs the agent to use rlm_query.
# ---------------------------------------------------------------------------
rlm:
  maxIterations: 10
  truncateThreshold: 6000
  # provider: local
  # model: llama3

# ---------------------------------------------------------------------------
# Cost Rates
#
# Optional. Maps "providerName/model" keys to per-1k-token prices in USD.
# providerName must match a name in providers[]. Omitting a provider/model
# pair treats it as free ($0). Local/Ollama models can be omitted entirely.
#
# Rates are stored historically — changing a price does not rewrite past data.
# Old spans keep the rate that was active when they ran.
# ---------------------------------------------------------------------------
# costs:
#   anthropic/claude-sonnet-4-6:
#     inputPer1kTokens: 0.003
#     outputPer1kTokens: 0.015
#   openai/gpt-4.1-mini:
#     inputPer1kTokens: 0.0004
#     outputPer1kTokens: 0.0012


# ---------------------------------------------------------------------------
# Agent
#
# Controls agent execution behaviour across the chat and wiki ingestion agents.
#
# recursionLimit: maximum LangGraph steps per invocation (default 100).
#                 LangGraph counts every node execution, including tool calls.
# recursionWarnThreshold: fraction of the limit at which the guard fires an
#                 interrupt() before the graph is killed. At 0.75 the guard
#                 interrupts at ~75 steps out of 100, leaving a safety margin.
#                 Must be between 0.10 and 0.99.
# ---------------------------------------------------------------------------
# agent:
#   recursionLimit: 100
#   recursionWarnThreshold: 0.75

# ---------------------------------------------------------------------------
# Shell Execution Tool
#
# Optional. Configures the shell_exec agent tool and the trusted executor
# used by SkillsManager for skill scripts.
#
# workingDirectory: the working directory for all spawned commands.
#                   Defaults to /app.
#
# allowlist:  glob-style patterns for commands that run without user approval.
#             * matches any characters (including spaces).
#             Example: "git *" allows any git sub-command.
#             Patterns are anchored (^ and $) — "git" does NOT match "git status".
#
# denylist:   glob-style patterns that are always blocked, even if they also
#             match the allowlist. Checked first — denylist always wins.
#
# env:        explicit environment variables injected into every spawned shell.
#             The process environment is NOT inherited (security constraint).
#             PATH defaults to /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin.
#             Add any additional variables you want the agent shell to see, e.g. GH_TOKEN.
# ---------------------------------------------------------------------------
# tools:
#   shell:
#     workingDirectory: /app
#     allowlist:
#       - "ls *"
#       - "git status"
#       - "git log *"
#     denylist:
#       - "rm *"
#       - "sudo *"
#     env:
#       PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#       # GH_TOKEN: ${GH_TOKEN}

# ---------------------------------------------------------------------------
# Workspace Task Trackers
#
# Optional. Configures the built-in GitHub tracker adapter used for linking
# tasks to GitHub issues/PRs from the task drawer.
#
# token: a GitHub personal access token. Omit it (or leave this whole block
#        commented out) for read-only "link existing issue" mode — unauthenticated
#        GitHub API calls, rate-limited to 60 req/hr, no issue creation. Provide
#        a token with `repo` scope (or `public_repo` for public repos only) to
#        also enable creating new GitHub issues from the task drawer.
# ---------------------------------------------------------------------------
# workspaces:
#   tasks:
#     trackers:
#       github:
#         token: ${GITHUB_TOKEN}
