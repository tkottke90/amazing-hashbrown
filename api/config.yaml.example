# Example configuration for amazing-hashbrown.
# Copy this to config.yaml (or start from a copy created by the bootstrap script)
# and edit to match your environment.

# (truncated for brevity; include your existing config lines here)

# Optional: provider/model pairs pinned to the top of the chat Provider menu.
# Each `provider` must match a configured provider's `name`. Also editable on
# Settings -> Model providers -> Favorites. See docs/App-Docs/Providers.md.
# favoriteModels:
#   - provider: local
#     model: qwen3:14b

tools:
  # Example tools with default configurations.
  # shell_exec is a special tool with its own workingDirectory default.
  # It also supports an optional "env" field for extra environment variables.
  shell_exec:
    # Optional: extra env vars for shell_exec child commands, layered on top
    # of the minimal environment (PATH/HOME/USER); an entry with the same
    # name overrides the default. Names must be uppercase. Values may be a
    # "${VAR}" lookup (resolved from the API's environment at load time), a
    # literal, or a mix like "${HOME}/bin". Literals are stored here as plain
    # text, so keep secrets in the environment and reference them by lookup.
    env:
      GH_TOKEN: "${GH_TOKEN}"
