# amazing-hashbrown API configuration
#
# Copy this file to config/config.yaml and edit for your environment.
# Use ${ENV_VAR} syntax to reference environment variables from the file.
# The config/config.yaml file is auto-created from these defaults on first run
# if it does not exist. config/ is gitignored — this example is the committed
# reference.

# Port the API server listens on.
port: 3000
# port: ${PORT}

# Log level: debug | info | warn | error
logLevel: info
# logLevel: ${LOG_LEVEL}

# Absolute or relative path to the knowledge-base root directory.
wikiRoot: ./config/kb
# wikiRoot: ${WIKI_ROOT}

# Directory that holds mcp.json and other runtime config files.
# When MCP_CONFIG_PATH is set, use: dirname(MCP_CONFIG_PATH)
mcpConfigDir: ./config

# ---------------------------------------------------------------------------
# LLM Providers
#
# At least one provider is required for the chat agent to function.
# Use ${ENV_VAR} syntax for secrets so they are not stored in the file.
# ---------------------------------------------------------------------------
providers:
  - name: local
    type: ollama
    baseUrl: http://localhost:11434
    defaultModel: llama3
  # - name: openai
  #   type: openai
  #   apiKey: ${OPENAI_API_KEY}
  #   defaultModel: gpt-4.1-mini
  # - name: anthropic
  #   type: anthropic
  #   apiKey: ${ANTHROPIC_API_KEY}
  #   defaultModel: claude-sonnet-4-6

defaultProvider: local

# ---------------------------------------------------------------------------
# Embeddings
#
# Powers semantic/hybrid wiki search (wiki_search tool's `mode`). When
# disabled, wiki search falls back to keyword-only matching — no error, just
# lower-quality ranking. Currently a single local Ollama embedding model;
# no API key needed.
# ---------------------------------------------------------------------------
embeddings:
  enabled: true
  model: nomic-embed-text
  baseUrl: http://localhost:11434/v1

# ---------------------------------------------------------------------------
# Database
#
# Shared SQLite database used by all application features (observability,
# task system, persistent memory). Do not delete this file between restarts.
# ---------------------------------------------------------------------------
database:
  # Path to the application database file. Relative paths are resolved from the
  # directory that contains this config file. Use an absolute path for production.
  # All application features share this file.
  path: app.db

# ---------------------------------------------------------------------------
# Observability
#
# Controls agent tracing: token counts, latency, and tool call records.
# Writes to the shared database configured above.
# ---------------------------------------------------------------------------
observability:
  enabled: true
  # How many characters of LLM responses and tool results to store per span.
  # Set to -1 to store full content (high fidelity, higher disk use).
  # Set to  0 to store no content (metrics-only mode: tokens, latency, cost).
  spanOutputPreviewChars: 500

# ---------------------------------------------------------------------------
# AfterAgent Middleware
#
# Background post-response layer that inspects each conversational turn for
# novel knowledge and writes it into the wiki. Runs after the turn's SSE
# stream completes; never blocks or slows the user-facing response. Can also
# be disabled per-request via the `afterAgent` field on POST /api/v1/chat/:threadId.
# ---------------------------------------------------------------------------
afterAgent:
  enabled: true

# ---------------------------------------------------------------------------
# Chat
#
# showErrorMessages: when false (default), a failed turn that has since been
# retried is hidden from the conversation history — only the successful
# retry shows. A failed turn nobody has retried yet is always shown
# regardless of this setting. Override per-request via
# GET /api/v1/threads/:id?showErrors=true.
# ---------------------------------------------------------------------------
chat:
  showErrorMessages: false

# ---------------------------------------------------------------------------
# Cost Rates
#
# Optional. Maps "providerName/model" keys to per-1k-token prices in USD.
# providerName must match a name in providers[]. Omitting a provider/model
# pair treats it as free ($0). Local/Ollama models can be omitted entirely.
#
# Rates are stored historically — changing a price does not rewrite past data.
# Old spans keep the rate that was active when they ran.
# ---------------------------------------------------------------------------
# costs:
#   anthropic/claude-sonnet-4-6:
#     inputPer1kTokens: 0.003
#     outputPer1kTokens: 0.015
#   openai/gpt-4.1-mini:
#     inputPer1kTokens: 0.0004
#     outputPer1kTokens: 0.0012
